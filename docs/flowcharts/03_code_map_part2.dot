digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=16, labelloc=t, nodesep=0.25, ranksep=0.45, pad=0.3];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.06"];
  edge [arrowsize=0.7, fontname="Helvetica"];
  label="Part 2: Physical layer, calibration, receivers and DL classifier: code → outputs";
  prx [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="gnuradio/packet_receiver_general.py\n(packet_receiver_test*.py: history)\n— BPSK/QPSK/16-QAM packet receiver"];
  prx_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/packet_receiver_*_validation.csv\npacket_receiver_seed_sweep.csv\n→ receiver decodes each modulation"];
  prx -> prx_o0 [color="#2E7D57"];
  dev [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="gnuradio/first_signal · packet_link_test · ideal_16qam\npulse_shaping / timing / carrier_recovery_16qam\nchannel_transparency · channel_receiver_alignment\n— Receiver development checks"];
  calib [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="gnuradio/calibrate_receiver.py\nrefine_calibration.py · expand_calibration.py\n— Packet success vs noise voltage (equal power)"];
  calib_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/equal_power_modulation_calibration.csv (330)\nrefined_... (930) · expanded_... (2,070)\n→ packet success measured per modulation"];
  calib -> calib_o0 [color="#2E7D57"];
  logit [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="gnuradio/analyze_calibration.py\nvalidate_logistic_models.py\n— Logistic fit + leave-one-seed-out check"];
  logit_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="coefficients a, b per modulation\nBrier / log loss / accuracy\n→ packet-success model used by Part 1"];
  logit -> logit_o0 [color="#2E7D57"];
  snr [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="gnuradio/measure_channel_snr.py · extend_*_snr.py\nsnr_measurement · receiver_snr_estimator\ntest_three_channel_estimators.py\n— Noise voltage <-> SNR (matched paths)"];
  snr_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/channel_snr_calibration.csv (1,530)\nchannel_snr_extension*.csv\n→ SNR in dB for each noise voltage"];
  snr -> snr_o0 [color="#2E7D57"];
  ncal [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/noise_calibration.py\n— Interpolates SNR -> noise voltage"];
  fac [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/generate_faculty_results.py\n— Calibration figures"];
  fac_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/figures/01_packet_success_calibration.png\n02_snr_noise_comparison.png\n→ calibration curves"];
  fac -> fac_o0 [color="#2E7D57"];
  sync [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/receiver_sync.py · multipath_channel.py\nsrc/validate_*_sync.py · validate_*_correction.py\nvalidate_multipath.py · validate_reference_snr.py\n— Timing / CFO / SRO / multipath synchronisation"];
  sync_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/synchronization/**\n*_sync_validation_*.csv\n→ sync accuracy under each impairment"];
  sync -> sync_o0 [color="#2E7D57"];
  wave [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/radio/waveform_generator.py · bpsk_frame.py\nmultimod_frame.py · scripts/run_multimod_experiment.py\n— Framed BPSK/QPSK/16-QAM waveforms"];
  wave_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/baseband/prepared/bpsk_frame_v2_seed42.*\nresults/baseband/multimod_v2/*\n→ TX files used by Part 3"];
  wave -> wave_o0 [color="#2E7D57"];
  rx [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/radio/bpsk_receiver.py\nmultimod_receiver.py\n— Frame sync, CFO, phase tracking, BER, Es/N0"];
  ber [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="scripts/ber_curves.py · plot_ber_synthetic.py\nsrc/radio/cognitive_controller.py\n— Synthetic BER vs Es/N0, switching thresholds"];
  ber_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/analysis/ber_vs_snr_multimod_synthetic.csv\ncontroller_thresholds_synthetic.json\nresults/figures/ber_vs_esn0_synthetic.png\n→ BER<=1e-3 at 6.8 / 9.9 / 16.7 dB"];
  ber -> ber_o0 [color="#2E7D57"];
  dl [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/dl/modulation_classifier.py\nscripts/train_modulation_classifier.py\nscripts/evaluate_dl_strict.py\n— CNN: recognise modulation from IQ"];
  dl_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/dl/ (model, metrics.json, strict_evaluation.json, plots)\n→ 98.5 % on real OTA (CI 96.2-99.8 %)"];
  dl -> dl_o0 [color="#2E7D57"];
  { rank=same; prx; dev; calib; logit; snr; ncal; fac; sync; wave; rx; ber; dl; }
  prx -> dev [style=invis];
  dev -> calib [style=invis];
  calib -> logit [style=invis];
  logit -> snr [style=invis];
  snr -> ncal [style=invis];
  ncal -> fac [style=invis];
  fac -> sync [style=invis];
  sync -> wave [style=invis];
  wave -> rx [style=invis];
  rx -> ber [style=invis];
  ber -> dl [style=invis];
  dev -> prx [style=dashed, color="#777777", constraint=false];
  prx -> calib [style=dashed, color="#777777", constraint=false];
  calib -> logit [style=dashed, color="#777777", constraint=false];
  snr -> ncal [style=dashed, color="#777777", constraint=false];
  logit -> fac [style=dashed, color="#777777", constraint=false];
  snr -> fac [style=dashed, color="#777777", constraint=false];
  sync -> rx [style=dashed, color="#777777", constraint=false];
  wave -> rx [style=dashed, color="#777777", constraint=false];
  rx -> ber [style=dashed, color="#777777", constraint=false];
  wave -> dl [style=dashed, color="#777777", constraint=false];
  legend [shape=plaintext, fontsize=9, label="Box = code (— what it does)   Note = output (→ what it shows)   Dashed = code dependency"];
}
