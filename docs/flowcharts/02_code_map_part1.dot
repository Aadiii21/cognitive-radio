digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=16, labelloc=t, nodesep=0.25, ranksep=0.45, pad=0.3];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.06"];
  edge [arrowsize=0.7, fontname="Helvetica"];
  label="Part 1: Simulation, cognitive control and ML analysis: code → outputs";
  chan [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/channel_model.py\n(channel_model_v1.py: history)\n— 3-channel SNR traces with interference"];
  metr [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/metrics.py · src/switching.py\n— PDR / throughput / availability; handoff delay"];
  ctrl [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/controller.py · controller_cost_aware.py\ncontroller_reliability_v1/v2.py · modulation_policy.py\n— Baseline, AMC, switching, hybrid, cost-aware decisions"];
  cal [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/calibrated_controller.py\n— Utility = rate x logistic packet success"];
  sims [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/simulate*.py · dwell_sweep.py\n— Early strategy runs and parameter sweeps"];
  sims_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/baseline.txt · cost_aware.txt\nsimulate_v6.txt\n→ early strategy summaries"];
  sims -> sims_o0 [color="#2F5D8A"];
  sims_o1 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/reliability_sweep*.txt\ndwell_sweep*.txt\n→ effect of PDR target / dwell time"];
  sims -> sims_o1 [color="#2F5D8A"];
  bench [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/multi_seed_experiment.py\n— 630 runs: 3 environments x 30 seeds x 7 strategies"];
  bench_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/calibrated_multi_seed_results.csv\n→ main benchmark dataset (630 rows)"];
  bench -> bench_o0 [color="#2F5D8A"];
  pair [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/paired_seed_analysis.py\n— Paired differences, 95 % CIs"];
  pair_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/paired_seed_analysis_v3.txt\n→ is strategy A really better than B?"];
  pair -> pair_o0 [color="#2F5D8A"];
  anal [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/analyze_benchmark.py · scripts/final_validation.sh\n— Benchmark figures and tables"];
  anal_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/figures/throughput_comparison.png\npdr_comparison.png · switching_availability.png\n→ strategy comparison"];
  anal -> anal_o0 [color="#2F5D8A"];
  anal_o1 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/final/plots/ · tables/\n→ per-environment PDR, throughput, availability"];
  anal -> anal_o1 [color="#2F5D8A"];
  ml [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/ml_analysis.py\n— Linear regression + random forest (seed-grouped split)"];
  ml_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/ml/\n→ how well conditions predict throughput / PDR"];
  ml -> ml_o0 [color="#2F5D8A"];
  srad [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/radio/base.py · simulated_radio.py\nsrc/run_radio_controller.py\n— Controller driving a simulated radio"];
  srad_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="console metrics (500 / 5,000 steps)\n→ control loop works end to end in software"];
  srad -> srad_o0 [color="#2F5D8A"];
  grctl [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/gnuradio_adapter.py · gnuradio_controller.py\ngnuradio_joint_controller.py · gnuradio/joint_cognitive_radio.py\ngnuradio/test_*control*, test_*switch*, test_channel_selector, test_transmission_gate\n— Controller inside GNU Radio flowgraphs"];
  exp [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="experiments/automatic_interference.py\nanalyze_interference · calculate_* · finalize · plot_experiment\n— Live 3-phase interference experiment"];
  exp_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/decision_trace.csv\nautomatic_interference_events.csv\n→ decision log over time"];
  exp -> exp_o0 [color="#2F5D8A"];
  exp_o1 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/final_experiment_metrics.csv\ncognitive_radio_experiment_final.png\n→ channel picked correctly? availability"];
  exp -> exp_o1 [color="#2F5D8A"];
  { rank=same; chan; metr; ctrl; cal; sims; bench; pair; anal; ml; srad; grctl; exp; }
  chan -> metr [style=invis];
  metr -> ctrl [style=invis];
  ctrl -> cal [style=invis];
  cal -> sims [style=invis];
  sims -> bench [style=invis];
  bench -> pair [style=invis];
  pair -> anal [style=invis];
  anal -> ml [style=invis];
  ml -> srad [style=invis];
  srad -> grctl [style=invis];
  grctl -> exp [style=invis];
  chan -> ctrl [style=dashed, color="#777777", constraint=false];
  metr -> ctrl [style=dashed, color="#777777", constraint=false];
  ctrl -> cal [style=dashed, color="#777777", constraint=false];
  ctrl -> sims [style=dashed, color="#777777", constraint=false];
  cal -> bench [style=dashed, color="#777777", constraint=false];
  chan -> bench [style=dashed, color="#777777", constraint=false];
  bench -> pair [style=dashed, color="#777777", constraint=false];
  bench -> anal [style=dashed, color="#777777", constraint=false];
  bench -> ml [style=dashed, color="#777777", constraint=false];
  cal -> srad [style=dashed, color="#777777", constraint=false];
  ctrl -> grctl [style=dashed, color="#777777", constraint=false];
  grctl -> exp [style=dashed, color="#777777", constraint=false];
  legend [shape=plaintext, fontsize=9, label="Box = code (— what it does)   Note = output (→ what it shows)   Dashed = code dependency"];
}
