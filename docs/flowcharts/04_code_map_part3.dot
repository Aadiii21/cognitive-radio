digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=16, labelloc=t, nodesep=0.25, ranksep=0.45, pad=0.3];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.06"];
  edge [arrowsize=0.7, fontname="Helvetica"];
  label="Part 3: SDR hardware integration and OTA experiments: code → outputs";
  hcfg [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/radio/hardware_config.py\n— Pluto URI, rates, verified limits"];
  tx [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/radio/pluto_pyadi_tx.py (default)\npluto_tx_adapter.py · pluto_transmitter.py\n— Pluto TX: cyclic buffer, gain, LO"];
  rxh [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/radio/rtl_sdr_sensor.py · rtl_capture.py\npluto_sensor.py\n— RTL-SDR / Pluto receive and sensing"];
  sense [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/hardware_dual_sensor.py\n— Power sensing on 3 channels"];
  sense_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/hardware_corrected/ · hardware_stability/\ndual_sensor_*.csv\n→ measured channel power, decisions"];
  sense -> sense_o0 [color="#B8621B"];
  dset [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/radio/capture_rtl_dataset.py\nsrc/extract_features.py\n— RTL capture dataset + spectral features"];
  dset_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="data/raw · data/metadata\nresults/features/*.csv\n→ labelled captures and features"];
  dset -> dset_o0 [color="#B8621B"];
  rplot [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/plot_rtlsdr_scan.py · plot_rtlsdr_peaks.py\nplot_iq_comparison.py\n— FM / spectrum survey plots"];
  rplot_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/figures/rtl_sdr_*.png\nrtl_sdr_fm_scan.csv\n→ RTL-SDR works; spectrum view"];
  rplot -> rplot_o0 [color="#B8621B"];
  run [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="scripts/run_hardware_experiment.py\n— Safe OTA runner: gates, TX, capture, decode"];
  run_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/hardware/captures/*.cu8 + .json\n→ raw IQ + metadata per run"];
  run -> run_o0 [color="#B8621B"];
  run_o1 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/hardware/experiment_results/*.json\nresults/hardware/day_01_*.log\n→ tone detection, frames, BER, Es/N0"];
  run -> run_o1 [color="#B8621B"];
  annot [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="scripts/annotate_rf_path.py\n— Records the real RF path (OTA)"];
  annot_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="rf_path_correction in run JSONs\n→ honest labelling of 23 Nov runs"];
  annot -> annot_o0 [color="#B8621B"];
  sweep [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="scripts/summarize_hardware_sweep.py\n— Hardware BER table, 95 % CIs, implied loss, figure"];
  sweep_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/analysis/hardware_ber_runs.csv (19 runs)\nresults/figures/hardware_ber_vs_theory.png\n→ measured BER ~ AWGN theory; thresholds hold"];
  sweep -> sweep_o0 [color="#B8621B"];
  pipe [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="pipelines/integrated_pipeline.py\n(scripts/pluto_to_rtl_sdr_demo.py, test_pluto_tx_adapter.py: legacy)\n— Software-mode pipeline; RF path disabled"];
  pipe_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/pipeline/\n→ software-only run"];
  pipe -> pipe_o0 [color="#B8621B"];
  { rank=same; hcfg; tx; rxh; sense; dset; rplot; run; annot; sweep; pipe; }
  hcfg -> tx [style=invis];
  tx -> rxh [style=invis];
  rxh -> sense [style=invis];
  sense -> dset [style=invis];
  dset -> rplot [style=invis];
  rplot -> run [style=invis];
  run -> annot [style=invis];
  annot -> sweep [style=invis];
  sweep -> pipe [style=invis];
  hcfg -> tx [style=dashed, color="#777777", constraint=false];
  hcfg -> rxh [style=dashed, color="#777777", constraint=false];
  rxh -> sense [style=dashed, color="#777777", constraint=false];
  rxh -> dset [style=dashed, color="#777777", constraint=false];
  rxh -> rplot [style=dashed, color="#777777", constraint=false];
  tx -> run [style=dashed, color="#777777", constraint=false];
  rxh -> run [style=dashed, color="#777777", constraint=false];
  run -> annot [style=dashed, color="#777777", constraint=false];
  run -> sweep [style=dashed, color="#777777", constraint=false];
  legend [shape=plaintext, fontsize=9, label="Box = code (— what it does)   Note = output (→ what it shows)   Dashed = code dependency"];
}
