digraph G {
  graph [rankdir=LR, newrank=true, fontname="Helvetica", fontsize=16, labelloc=t, nodesep=0.25, ranksep=0.45, pad=0.3];
  node [fontname="Helvetica", fontsize=10, margin="0.12,0.06"];
  edge [arrowsize=0.7, fontname="Helvetica"];
  label="Cognitive radio project: all code → outputs (3 parts)";
  subgraph cluster_p1 {
  label="Part 1: Simulation, cognitive control and ML analysis"; style="rounded"; color="#2F5D8A"; fontsize=14;
  p1_chan [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/channel_model.py\n(channel_model_v1.py: history)\n— 3-channel SNR traces with interference"];
  p1_metr [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/metrics.py · src/switching.py\n— PDR / throughput / availability; handoff delay"];
  p1_ctrl [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/controller.py · controller_cost_aware.py\ncontroller_reliability_v1/v2.py · modulation_policy.py\n— Baseline, AMC, switching, hybrid, cost-aware decisions"];
  p1_cal [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/calibrated_controller.py\n— Utility = rate x logistic packet success"];
  p1_sims [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/simulate*.py · dwell_sweep.py\n— Early strategy runs and parameter sweeps"];
  p1_sims_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/baseline.txt · cost_aware.txt\nsimulate_v6.txt\n→ early strategy summaries"];
  p1_sims -> p1_sims_o0 [color="#2F5D8A"];
  p1_sims_o1 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/reliability_sweep*.txt\ndwell_sweep*.txt\n→ effect of PDR target / dwell time"];
  p1_sims -> p1_sims_o1 [color="#2F5D8A"];
  p1_bench [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/multi_seed_experiment.py\n— 630 runs: 3 environments x 30 seeds x 7 strategies"];
  p1_bench_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/calibrated_multi_seed_results.csv\n→ main benchmark dataset (630 rows)"];
  p1_bench -> p1_bench_o0 [color="#2F5D8A"];
  p1_pair [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/paired_seed_analysis.py\n— Paired differences, 95 % CIs"];
  p1_pair_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/paired_seed_analysis_v3.txt\n→ is strategy A really better than B?"];
  p1_pair -> p1_pair_o0 [color="#2F5D8A"];
  p1_anal [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/analyze_benchmark.py · scripts/final_validation.sh\n— Benchmark figures and tables"];
  p1_anal_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/figures/throughput_comparison.png\npdr_comparison.png · switching_availability.png\n→ strategy comparison"];
  p1_anal -> p1_anal_o0 [color="#2F5D8A"];
  p1_anal_o1 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/final/plots/ · tables/\n→ per-environment PDR, throughput, availability"];
  p1_anal -> p1_anal_o1 [color="#2F5D8A"];
  p1_ml [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/ml_analysis.py\n— Linear regression + random forest (seed-grouped split)"];
  p1_ml_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/ml/\n→ how well conditions predict throughput / PDR"];
  p1_ml -> p1_ml_o0 [color="#2F5D8A"];
  p1_sens [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="scripts/sensitivity_analysis.py\n— Switching-penalty sweep; 1-2 dB implementation loss; safety margin"];
  p1_sens_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/sensitivity/ (penalty_sweep, implementation_loss,\nsafety_margin .csv/.png)\n→ result holds for any penalty; 0.25 better; 1 dB margin restores PDR"];
  p1_sens -> p1_sens_o0 [color="#2F5D8A"];
  p1_srad [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/radio/base.py · simulated_radio.py\nsrc/run_radio_controller.py\n— Controller driving a simulated radio"];
  p1_srad_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="console metrics (500 / 5,000 steps)\n→ control loop works end to end in software"];
  p1_srad -> p1_srad_o0 [color="#2F5D8A"];
  p1_grctl [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="src/gnuradio_adapter.py · gnuradio_controller.py\ngnuradio_joint_controller.py · gnuradio/joint_cognitive_radio.py\ngnuradio/test_*control*, test_*switch*, test_channel_selector, test_transmission_gate\n— Controller inside GNU Radio flowgraphs"];
  p1_exp [shape=box, style="rounded,filled", fillcolor="#DCE8F7", color="#2F5D8A", label="experiments/automatic_interference.py\nanalyze_interference · calculate_* · finalize · plot_experiment\n— Live 3-phase interference experiment"];
  p1_exp_o0 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/decision_trace.csv\nautomatic_interference_events.csv\n→ decision log over time"];
  p1_exp -> p1_exp_o0 [color="#2F5D8A"];
  p1_exp_o1 [shape=note, style=filled, fillcolor="#F2F7FC", color="#2F5D8A", fontsize=9, label="results/final_experiment_metrics.csv\ncognitive_radio_experiment_final.png\n→ channel picked correctly? availability"];
  p1_exp -> p1_exp_o1 [color="#2F5D8A"];
  { rank=same; p1_chan; p1_metr; p1_ctrl; p1_cal; p1_sims; p1_bench; p1_pair; p1_anal; p1_ml; p1_sens; p1_srad; p1_grctl; p1_exp; }
  p1_chan -> p1_metr [style=invis];
  p1_metr -> p1_ctrl [style=invis];
  p1_ctrl -> p1_cal [style=invis];
  p1_cal -> p1_sims [style=invis];
  p1_sims -> p1_bench [style=invis];
  p1_bench -> p1_pair [style=invis];
  p1_pair -> p1_anal [style=invis];
  p1_anal -> p1_ml [style=invis];
  p1_ml -> p1_sens [style=invis];
  p1_sens -> p1_srad [style=invis];
  p1_srad -> p1_grctl [style=invis];
  p1_grctl -> p1_exp [style=invis];
  p1_chan -> p1_ctrl [style=dashed, color="#777777", constraint=false];
  p1_metr -> p1_ctrl [style=dashed, color="#777777", constraint=false];
  p1_ctrl -> p1_cal [style=dashed, color="#777777", constraint=false];
  p1_ctrl -> p1_sims [style=dashed, color="#777777", constraint=false];
  p1_cal -> p1_bench [style=dashed, color="#777777", constraint=false];
  p1_chan -> p1_bench [style=dashed, color="#777777", constraint=false];
  p1_bench -> p1_pair [style=dashed, color="#777777", constraint=false];
  p1_bench -> p1_anal [style=dashed, color="#777777", constraint=false];
  p1_bench -> p1_ml [style=dashed, color="#777777", constraint=false];
  p1_cal -> p1_srad [style=dashed, color="#777777", constraint=false];
  p1_bench -> p1_sens [style=dashed, color="#777777", constraint=false];
  p1_ctrl -> p1_grctl [style=dashed, color="#777777", constraint=false];
  p1_grctl -> p1_exp [style=dashed, color="#777777", constraint=false];
  }
  subgraph cluster_p2 {
  label="Part 2: Physical layer, calibration, receivers and DL classifier"; style="rounded"; color="#2E7D57"; fontsize=14;
  p2_prx [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="gnuradio/packet_receiver_general.py\n(packet_receiver_test*.py: history)\n— BPSK/QPSK/16-QAM packet receiver"];
  p2_prx_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/packet_receiver_*_validation.csv\npacket_receiver_seed_sweep.csv\n→ receiver decodes each modulation"];
  p2_prx -> p2_prx_o0 [color="#2E7D57"];
  p2_dev [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="gnuradio/first_signal · packet_link_test · ideal_16qam\npulse_shaping / timing / carrier_recovery_16qam\nchannel_transparency · channel_receiver_alignment\n— Receiver development checks"];
  p2_calib [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="gnuradio/calibrate_receiver.py\nrefine_calibration.py · expand_calibration.py\n— Packet success vs noise voltage (equal power)"];
  p2_calib_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/equal_power_modulation_calibration.csv (330)\nrefined_... (930) · expanded_... (2,070)\n→ packet success measured per modulation"];
  p2_calib -> p2_calib_o0 [color="#2E7D57"];
  p2_logit [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="gnuradio/analyze_calibration.py\nvalidate_logistic_models.py\n— Logistic fit + leave-one-seed-out check"];
  p2_logit_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="coefficients a, b per modulation\nBrier / log loss / accuracy\n→ packet-success model used by Part 1"];
  p2_logit -> p2_logit_o0 [color="#2E7D57"];
  p2_snr [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="gnuradio/measure_channel_snr.py · extend_*_snr.py\nsnr_measurement · receiver_snr_estimator\ntest_three_channel_estimators.py\n— Noise voltage <-> SNR (matched paths)"];
  p2_snr_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/channel_snr_calibration.csv (1,530)\nchannel_snr_extension*.csv\n→ SNR in dB for each noise voltage"];
  p2_snr -> p2_snr_o0 [color="#2E7D57"];
  p2_ncal [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/noise_calibration.py\n— Interpolates SNR -> noise voltage"];
  p2_fac [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/generate_faculty_results.py\n— Calibration figures"];
  p2_fac_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/figures/01_packet_success_calibration.png\n02_snr_noise_comparison.png\n→ calibration curves"];
  p2_fac -> p2_fac_o0 [color="#2E7D57"];
  p2_sync [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/receiver_sync.py · multipath_channel.py\nsrc/validate_*_sync.py · validate_*_correction.py\nvalidate_multipath.py · validate_reference_snr.py\n— Timing / CFO / SRO / multipath synchronisation"];
  p2_sync_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/synchronization/**\n*_sync_validation_*.csv\n→ sync accuracy under each impairment"];
  p2_sync -> p2_sync_o0 [color="#2E7D57"];
  p2_wave [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/radio/waveform_generator.py · bpsk_frame.py\nmultimod_frame.py · scripts/run_multimod_experiment.py\n— Framed BPSK/QPSK/16-QAM waveforms"];
  p2_wave_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/baseband/prepared/bpsk_frame_v2_seed42.*\nresults/baseband/multimod_v2/*\n→ TX files used by Part 3"];
  p2_wave -> p2_wave_o0 [color="#2E7D57"];
  p2_rx [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/radio/bpsk_receiver.py\nmultimod_receiver.py\n— Frame sync, CFO, phase tracking, BER, Es/N0"];
  p2_ber [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="scripts/ber_curves.py · plot_ber_synthetic.py\nsrc/radio/cognitive_controller.py\n— Synthetic BER vs Es/N0, switching thresholds"];
  p2_ber_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/analysis/ber_vs_snr_multimod_synthetic.csv\ncontroller_thresholds_synthetic.json\nresults/figures/ber_vs_esn0_synthetic.png\n→ BER<=1e-3 at 6.8 / 9.9 / 16.7 dB"];
  p2_ber -> p2_ber_o0 [color="#2E7D57"];
  p2_dl [shape=box, style="rounded,filled", fillcolor="#D9EFE4", color="#2E7D57", label="src/dl/modulation_classifier.py\nscripts/train_modulation_classifier.py\nscripts/evaluate_dl_strict.py\n— CNN: recognise modulation from IQ"];
  p2_dl_o0 [shape=note, style=filled, fillcolor="#F1F9F5", color="#2E7D57", fontsize=9, label="results/dl/ (model, metrics.json, strict_evaluation.json, plots)\n→ 98.5 % on real OTA (CI 96.2-99.8 %)"];
  p2_dl -> p2_dl_o0 [color="#2E7D57"];
  { rank=same; p2_prx; p2_dev; p2_calib; p2_logit; p2_snr; p2_ncal; p2_fac; p2_sync; p2_wave; p2_rx; p2_ber; p2_dl; }
  p2_prx -> p2_dev [style=invis];
  p2_dev -> p2_calib [style=invis];
  p2_calib -> p2_logit [style=invis];
  p2_logit -> p2_snr [style=invis];
  p2_snr -> p2_ncal [style=invis];
  p2_ncal -> p2_fac [style=invis];
  p2_fac -> p2_sync [style=invis];
  p2_sync -> p2_wave [style=invis];
  p2_wave -> p2_rx [style=invis];
  p2_rx -> p2_ber [style=invis];
  p2_ber -> p2_dl [style=invis];
  p2_dev -> p2_prx [style=dashed, color="#777777", constraint=false];
  p2_prx -> p2_calib [style=dashed, color="#777777", constraint=false];
  p2_calib -> p2_logit [style=dashed, color="#777777", constraint=false];
  p2_snr -> p2_ncal [style=dashed, color="#777777", constraint=false];
  p2_logit -> p2_fac [style=dashed, color="#777777", constraint=false];
  p2_snr -> p2_fac [style=dashed, color="#777777", constraint=false];
  p2_sync -> p2_rx [style=dashed, color="#777777", constraint=false];
  p2_wave -> p2_rx [style=dashed, color="#777777", constraint=false];
  p2_rx -> p2_ber [style=dashed, color="#777777", constraint=false];
  p2_wave -> p2_dl [style=dashed, color="#777777", constraint=false];
  }
  subgraph cluster_p3 {
  label="Part 3: SDR hardware integration and OTA experiments"; style="rounded"; color="#B8621B"; fontsize=14;
  p3_hcfg [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/radio/hardware_config.py\n— Pluto URI, rates, verified limits"];
  p3_tx [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/radio/pluto_pyadi_tx.py (default)\npluto_tx_adapter.py · pluto_transmitter.py\n— Pluto TX: cyclic buffer, gain, LO"];
  p3_rxh [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/radio/rtl_sdr_sensor.py · rtl_capture.py\npluto_sensor.py\n— RTL-SDR / Pluto receive and sensing"];
  p3_sense [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/hardware_dual_sensor.py\n— Power sensing on 3 channels"];
  p3_sense_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/hardware_corrected/ · hardware_stability/\ndual_sensor_*.csv\n→ measured channel power, decisions"];
  p3_sense -> p3_sense_o0 [color="#B8621B"];
  p3_dset [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/radio/capture_rtl_dataset.py\nsrc/extract_features.py\n— RTL capture dataset + spectral features"];
  p3_dset_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="data/raw · data/metadata\nresults/features/*.csv\n→ labelled captures and features"];
  p3_dset -> p3_dset_o0 [color="#B8621B"];
  p3_rplot [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="src/plot_rtlsdr_scan.py · plot_rtlsdr_peaks.py\nplot_iq_comparison.py\n— FM / spectrum survey plots"];
  p3_rplot_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/figures/rtl_sdr_*.png\nrtl_sdr_fm_scan.csv\n→ RTL-SDR works; spectrum view"];
  p3_rplot -> p3_rplot_o0 [color="#B8621B"];
  p3_run [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="scripts/run_hardware_experiment.py\n— Safe OTA runner: gates, TX, capture, decode"];
  p3_run_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/hardware/captures/*.cu8 + .json\n→ raw IQ + metadata per run"];
  p3_run -> p3_run_o0 [color="#B8621B"];
  p3_run_o1 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/hardware/experiment_results/*.json\nresults/hardware/day_01_*.log\n→ tone detection, frames, BER, Es/N0"];
  p3_run -> p3_run_o1 [color="#B8621B"];
  p3_annot [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="scripts/annotate_rf_path.py\n— Records the real RF path (OTA)"];
  p3_annot_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="rf_path_correction in run JSONs\n→ honest labelling of 23 Nov runs"];
  p3_annot -> p3_annot_o0 [color="#B8621B"];
  p3_sweep [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="scripts/summarize_hardware_sweep.py\n— Hardware BER table, 95 % CIs, implied loss, figure"];
  p3_sweep_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/analysis/hardware_ber_runs.csv (19 runs)\nresults/figures/hardware_ber_vs_theory.png\n→ measured BER ~ AWGN theory; thresholds hold"];
  p3_sweep -> p3_sweep_o0 [color="#B8621B"];
  p3_pipe [shape=box, style="rounded,filled", fillcolor="#FBE5D0", color="#B8621B", label="pipelines/integrated_pipeline.py\n(scripts/pluto_to_rtl_sdr_demo.py, test_pluto_tx_adapter.py: legacy)\n— Software-mode pipeline; RF path disabled"];
  p3_pipe_o0 [shape=note, style=filled, fillcolor="#FDF4EA", color="#B8621B", fontsize=9, label="results/pipeline/\n→ software-only run"];
  p3_pipe -> p3_pipe_o0 [color="#B8621B"];
  { rank=same; p3_hcfg; p3_tx; p3_rxh; p3_sense; p3_dset; p3_rplot; p3_run; p3_annot; p3_sweep; p3_pipe; }
  p3_hcfg -> p3_tx [style=invis];
  p3_tx -> p3_rxh [style=invis];
  p3_rxh -> p3_sense [style=invis];
  p3_sense -> p3_dset [style=invis];
  p3_dset -> p3_rplot [style=invis];
  p3_rplot -> p3_run [style=invis];
  p3_run -> p3_annot [style=invis];
  p3_annot -> p3_sweep [style=invis];
  p3_sweep -> p3_pipe [style=invis];
  p3_hcfg -> p3_tx [style=dashed, color="#777777", constraint=false];
  p3_hcfg -> p3_rxh [style=dashed, color="#777777", constraint=false];
  p3_rxh -> p3_sense [style=dashed, color="#777777", constraint=false];
  p3_rxh -> p3_dset [style=dashed, color="#777777", constraint=false];
  p3_rxh -> p3_rplot [style=dashed, color="#777777", constraint=false];
  p3_tx -> p3_run [style=dashed, color="#777777", constraint=false];
  p3_rxh -> p3_run [style=dashed, color="#777777", constraint=false];
  p3_run -> p3_annot [style=dashed, color="#777777", constraint=false];
  p3_run -> p3_sweep [style=dashed, color="#777777", constraint=false];
  }
  p2_logit -> p1_cal [color="#C0392B", penwidth=1.4, fontsize=9, fontcolor="#C0392B", label="packet-success model"];
  p2_ncal -> p1_cal [color="#C0392B", penwidth=1.4, fontsize=9, fontcolor="#C0392B", label="SNR -> noise voltage"];
  p2_wave -> p3_run [color="#C0392B", penwidth=1.4, fontsize=9, fontcolor="#C0392B", label="TX waveforms"];
  p2_rx -> p3_run [color="#C0392B", penwidth=1.4, fontsize=9, fontcolor="#C0392B", label="receivers"];
  p2_ber -> p3_sweep [color="#C0392B", penwidth=1.4, fontsize=9, fontcolor="#C0392B", label="theory / thresholds"];
  p3_run -> p2_dl [color="#C0392B", penwidth=1.4, fontsize=9, fontcolor="#C0392B", label="real captures (test set)"];
  legend [shape=plaintext, fontsize=9, label="Box = code (— what it does)   Note = output (→ what it shows)   Dashed = code dependency"];
}
